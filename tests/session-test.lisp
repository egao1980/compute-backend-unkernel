(in-package #:compute-backend-unkernel/tests)

;;; Open / exec / close, exit codes, stdout and stderr (live).

(deflive session-open-exec-close (backend)
  (with-tree (root area ro outside)
    (let ((s (sc:open-sandbox backend (area-spec area))))
      (ok (unkernel-session-p s))
      (ok (typep s 'sc:sandbox-session))
      (ok (eq backend (sc:sandbox-session-backend s)))
      (ok (unkernel-session-alive-p s))
      (ok (unkernel-plan-p (unkernel-session-plan s)))
      (ok (and (integerp (unkernel-session-boot-ms s)) (plusp (unkernel-session-boot-ms s))))
      (ok (integerp (unkernel-session-pid s)))
      (ok (pid-alive-p (unkernel-session-pid s)) "one host process per session")
      (multiple-value-bind (code out err) (session-exec s '("echo" "hello"))
        (ok (eql 0 code))
        (ok (equal (format nil "hello~%") out))
        (ok (equal "" err)))
      (ok (eq t (sc:close-sandbox s)))
      (ok (not (unkernel-session-alive-p s))))))

(deflive session-exit-codes (backend)
  (with-session (s backend nil)
    (ok (eql 0 (sh s "true")))
    (ok (eql 1 (sh s "false")))
    (ok (eql 3 (sh s "exit 3")))
    (ok (eql 255 (sh s "exit 255")))
    (ok (eql 127 (session-exec s '("no-such-program-anywhere"))) "not found: 127, not an error")
    (ok (eql 143 (sh s "kill -TERM $$")) "a signal death is 128 + signo")
    (ok (eql 137 (sh s "kill -KILL $$")))))

(deflive session-stdout-stderr (backend)
  (with-session (s backend nil)
    (multiple-value-bind (code out err) (sh s "echo out1; echo err1 >&2; echo out2; echo err2 >&2; exit 4")
      (ok (eql 4 code))
      (ok (equal (format nil "out1~%out2~%") out) "stdout alone")
      (ok (equal (format nil "err1~%err2~%") err) "stderr alone"))
    (multiple-value-bind (code out) (session-exec s '("printf" "%s" "héllo — ☃"))
      (ok (eql 0 code))
      (ok (equal "héllo — ☃" out) "UTF-8 both ways"))
    (multiple-value-bind (code out) (sh s "seq 1 20000 | wc -l")
      (ok (eql 0 code))
      (ok (equal "20000" (string-trim '(#\Space #\Newline) out))))
    (let ((big (nth-value 1 (sh s "seq 1 20000"))))
      (ok (= 20000 (count #\Newline big)) "large output is captured whole"))))

(deflive session-input-env-directory (backend)
  (with-tree (root area ro outside)
    (with-session (s backend (area-spec area :env '(("FROM_CONFINEMENT" . "c"))))
      (multiple-value-bind (code out) (session-exec s '("cat") :input (format nil "line1~%line2~%"))
        (ok (eql 0 code))
        (ok (equal (format nil "line1~%line2~%") out) "stdin"))
      (ok (equal "c" (sh-out s "echo $FROM_CONFINEMENT")))
      (ok (equal "x" (sh-out s "echo $EXTRA" :env '(("EXTRA" . "x")))))
      (ok (equal "y" (sh-out s "echo $FROM_CONFINEMENT" :env '(("FROM_CONFINEMENT" . "y"))))
          "per-exec env wins")
      (ok (equal (string-right-trim "/" (ns area)) (sh-out s "pwd")) "the start directory is the area")
      (ok (equal "/tmp" (sh-out s "pwd" :directory "/tmp")))
      (ok (equal "1000" (sh-out s "id -u")) "the distro user, not root"))))

(deflive session-host-env-does-not-leak (backend)
  (let ((old (uiop:getenv "UNKERNEL_TEST_LEAK")))
    (setf (uiop:getenv "UNKERNEL_TEST_LEAK") "leak")
    (unwind-protect
         (with-session (s backend nil)
           (ok (equal "" (sh-out s "printf %s \"$UNKERNEL_TEST_LEAK\"")))
           (ok (not (search (or (uiop:getenv "HOME") "/nonexistent-home") (sh-out s "env")))
               "not even the host's HOME"))
      (setf (uiop:getenv "UNKERNEL_TEST_LEAK") (or old "")))))

(deflive session-state-persists-within (backend)
  (with-session (s backend nil)
    (ok (eql 0 (sh s "echo kept > /home/user/state.txt")))
    (ok (equal "kept" (sh-out s "cat /home/user/state.txt")) "one kernel across execs"))
  (with-session (s backend nil)
    (ok (not (eql 0 (sh s "test -e /home/user/state.txt")))
        "a new session starts fresh: the guest disk is a snapshot")))

(deflive session-run-sandboxed (backend)
  (with-tree (root area ro outside)
    (let ((r (sc:run-sandboxed backend (area-spec area :command '("sh" "-c" "echo ran; echo e >&2; exit 2")
                                                       :artifacts '("out.txt")))))
      (ok (sc:sandbox-result-p r))
      (ok (eql 2 (sc:sandbox-result-exit-code r)))
      (ok (equal (format nil "ran~%") (sc:sandbox-result-stdout r)))
      (ok (equal (format nil "e~%") (sc:sandbox-result-stderr r)))
      (ok (equal '("out.txt") (sc:sandbox-result-artifacts r))))
    (ok (eql 0 (sc:sandbox-result-exit-code (sc:run-sandboxed backend '("true"))))
        "a bare command list")))

(deflive session-run-on-session (backend)
  (with-tree (root area ro outside)
    (let ((spec (area-spec area :command '("echo" "default"))))
      (with-session (s backend spec)
        (ok (equal (format nil "default~%") (sc:sandbox-result-stdout (sc:run-sandboxed s nil)))
            "NIL → the session spec's command")
        (ok (equal (format nil "other~%")
                   (sc:sandbox-result-stdout (sc:run-sandboxed s '("echo" "other")))))
        (ok (equal "v"
                   (string-trim '(#\Newline)
                                (sc:sandbox-result-stdout
                                 (sc:run-sandboxed s (sc:make-sandbox-spec :command '("sh" "-c" "echo $V")
                                                                           :env '(("V" . "v"))))))))
        (ok (signals (sc:run-sandboxed s (sc:make-sandbox-spec :command '("true") :network :allow))
                     'sc:compute-error)
            "the network is fixed at open")
        (ok (signals (sc:run-sandboxed s (sc:make-sandbox-spec :command '("true") :mounts (list (namestring ro))))
                     'sc:compute-error)
            "mounts are fixed at open")
        (ok (signals (sc:run-sandboxed s (sc:make-sandbox-spec :code "(+ 1 2)")) 'sc:sandbox-denied))
        (ok (unkernel-session-alive-p s) "refusals leave the session usable")
        (ok (eql 0 (sh s "true")))))))

(deflive session-with-sandbox (backend)
  (let (session)
    (ok (eql 0 (sc:with-sandbox (s backend '("true"))
                 (setf session s)
                 (sc:sandbox-result-exit-code (sc:run-sandboxed s nil)))))
    (ok (not (unkernel-session-alive-p session)) "closed by WITH-SANDBOX")))

(deflive session-refusal-creates-nothing (backend)
  (let ((before (stack-compute-dirs)))
    (with-tree (root area ro outside)
      (ok (signals (sc:open-sandbox backend (sc:make-sandbox-spec
                                             :confinement (sc:make-confinement :writable (list area)
                                                                               :read :all :deny-read '())))
                   'sc:invalid-confinement))
      (ok (signals (sc:open-sandbox backend (sc:make-sandbox-spec :command '("true") :cpu-limit 1))
                   'sc:sandbox-denied)))
    (ok (equal before (stack-compute-dirs)) "refused before any temp dir or process")))

(deflive session-two-at-once (backend)
  (with-session (a backend nil)
    (with-session (b backend nil)
      (ok (/= (unkernel-session-pid a) (unkernel-session-pid b)) "one process per session")
      (ok (eql 0 (sh a "echo a > /home/user/who")))
      (ok (not (eql 0 (sh b "test -e /home/user/who"))) "separate kernels")
      (ok (equal "a" (sh-out a "cat /home/user/who"))))))
