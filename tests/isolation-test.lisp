(in-package #:compute-backend-unkernel/tests)

;;; The extra isolation laws from the spike (live). Laws are about effects: what the
;;; guest can see, change or reach, judged on the host.

;;; 1. Unmounted paths are invisible

(deflive iso-unmounted-invisible (backend)
  (with-tree (root area ro outside)
    (let ((marker (format nil "unkernel-marker-~a" (random-hex))))
      (write-text (merge-pathnames marker outside) "hidden")
      (with-session (s backend (area-spec area :readable (list ro)))
        (ok (not (eql 0 (sh s (format nil "cat '~avictim'" (ns outside)))))
            "a host file beside the area cannot be read")
        (ok (not (eql 0 (sh s (format nil "test -e '~a'" (ns outside))))) "its directory does not exist")
        (ok (subsetp (uiop:split-string (sh-out s (format nil "ls '~a'" (ns root))) :separator '(#\Newline))
                     '("area" "ro") :test #'equal)
            "the area's parent holds only mount points, not the host's outside/")
        (ok (equal "" (sh-out s (format nil "find / -xdev -name '~a' 2>/dev/null; sudo find / -name '~a' 2>/dev/null" marker marker)))
            "a unique host file is found nowhere, not even by root")
        (let ((home (uiop:getenv "HOME")))
          (when (and home (plusp (length home)))
            (ok (not (eql 0 (sh s (format nil "ls '~a'" home)))) "the host's home is not there")))
        (ok (equal "readonly" (sh-out s (format nil "cat '~ar'" (ns ro)))) "what is mounted is readable")))))

(deflive iso-root-sees-only-mounts (backend)
  (with-tree (root area ro outside)
    (with-session (s backend (area-spec area :readable (list ro)))
      (let ((mounts (sh-out s "grep -E ' 9p ' /proc/mounts | cut -d' ' -f2 | sort")))
        (ok (equal (sort (list (string-right-trim "/" (ns area))
                               (string-right-trim "/" (ns ro))
                               (string-right-trim "/" (plan-tmp (unkernel-session-plan s))))
                         #'string<)
                   (uiop:split-string mounts :separator '(#\Newline)))
            "exactly the planned trees are served from the host")))))

;;; 2. Symlinks don't escape

(deflive iso-symlinks-do-not-escape (backend)
  (with-tree (root area ro outside)
    (let ((abs-link (merge-pathnames "abs-link" area))
          (rel-link (merge-pathnames "rel-link" area)))
      (pp:run (list "ln" "-s" (string-right-trim "/" (ns outside)) (uiop:native-namestring abs-link))
              :output :string :error-output :string)
      (pp:run (list "ln" "-s" "../outside" (uiop:native-namestring rel-link))
              :output :string :error-output :string)
      (with-session (s backend (area-spec area))
        (ok (not (eql 0 (sh s "cat abs-link/victim"))) "read through an absolute link → fails")
        (ok (not (eql 0 (sh s "cat rel-link/victim"))) "read through a relative link → fails")
        (sh s "echo x > abs-link/new; echo x > rel-link/new; echo x >> abs-link/victim")
        (ok (not (uiop:file-exists-p (merge-pathnames "new" outside))) "nothing created outside")
        (ok (equal "original" (read-text (merge-pathnames "victim" outside))) "the victim is unchanged")
        (ok (not (eql 0 (sh s "cat ../outside/victim"))) "`..` from the area stays in the guest")
        (ok (not (eql 0 (sh s (format nil "sudo cat '~avictim'" (ns outside))))) "also as root")))))

(deflive iso-no-new-9p-mounts (backend)
  (with-tree (root area ro outside)
    (with-session (s backend (area-spec area))
      (sh s "sudo mkdir -p /mnt/x; sudo mount -t 9p -o trans=fd,rfdno=0,wfdno=0 host /mnt/x" :wall-clock 30)
      (ok (equal "" (sh-out s "ls /mnt/x 2>/dev/null")) "a manual 9p mount serves nothing")
      (ok (not (search (ns outside) (sh-out s "cat /proc/mounts")))))))

;;; 3. No network

(deflive iso-no-network (backend)
  (multiple-value-bind (listener port) (open-listener)
    (unwind-protect
         (with-session (s backend nil)
           (ok (equal "lo" (sh-out s "ls /sys/class/net"))
               "only lo")
           (ok (not (search "10.0.2.15" (sh-out s "ip -4 addr 2>&1"))) "no guest address")
           (ok (not (eql 0 (sh s (format nil "nc -z -w 3 10.0.2.2 ~d" port) :wall-clock 30)))
               "the host (gateway) is unreachable")
           (ok (not (eql 0 (sh s "nc -z -w 3 1.1.1.1 80" :wall-clock 30))) "the internet is unreachable")
           (ok (not (eql 0 (sh s "nslookup example.com 2>/dev/null | grep -q Address:" :wall-clock 30)))
               "no DNS"))
      (close-socket listener))))

(deflive iso-network-allow-not-host-loopback (backend)
  (multiple-value-bind (listener port) (open-listener)
    (unwind-protect
         (with-session (s backend (sc:make-sandbox-spec :command '("true") :network :allow))
           (ok (eq :direct (plan-network (unkernel-session-plan s))))
           (ok (search "10.0.2.15" (sh-out s "ip -4 addr 2>&1")) ":allow brings eth0 up")
           (ok (not (eql 0 (sh s (format nil "nc -z -w 3 10.0.2.2 ~d" port) :wall-clock 30)))
               "the host's loopback stays unreachable (hostLoopback off)")
           (ok (not (eql 0 (sh s (format nil "nc -z -w 3 127.0.0.1 ~d" port) :wall-clock 30)))
               "guest 127.0.0.1 is the guest's own"))
      (close-socket listener))))

;;; 4. Read-write vs read-only mounts

(deflive iso-read-only-mounts (backend)
  (with-tree (root area ro outside)
    (let ((file-ro (merge-pathnames "victim" outside)))
      (with-session (s backend (sc:make-sandbox-spec
                                :confinement (area-confinement area :readable (list ro file-ro))
                                :mounts (list (list (namestring root) "/opt/root/"))))
        (ok (not (eql 0 (sh s (format nil "echo x > '~ar'" (ns ro)))))
            "a readable tree refuses writes")
        (ok (not (eql 0 (sh s (format nil "sudo sh -c \"echo x > '~ar'\"" (ns ro)))))
            "also as root: read-only is enforced host-side")
        (ok (not (eql 0 (sh s (format nil "sudo rm -f '~ar'" (ns ro))))))
        (ok (not (eql 0 (sh s (format nil "sudo sh -c \"echo x >> '~a'\"" (ns file-ro))))))
        (ok (not (eql 0 (sh s "sudo sh -c 'echo x > /opt/root/ro/new'"))) "a spec mount refuses writes")
        (ok (not (eql 0 (sh s "sudo touch /opt/root/area/through-ro-mount")))
            "the area seen through a read-only mount is read-only there")
        (ok (equal "readonly" (read-text (merge-pathnames "r" ro))) "unchanged on the host")
        (ok (equal "original" (read-text file-ro)))
        (ok (not (uiop:file-exists-p (merge-pathnames "ro/new" root))))
        (ok (not (uiop:file-exists-p (merge-pathnames "through-ro-mount" area))))
        (ok (eql 0 (sh s "echo w > f")) "the area itself stays writable")
        (ok (equal (format nil "w~%") (read-text (merge-pathnames "f" area))))))))

(deflive iso-read-write-both-ways (backend)
  (with-tree (root area ro outside)
    (with-session (s backend (area-spec area))
      (ok (eql 0 (sh s "echo from-guest > g.txt")))
      (ok (equal (format nil "from-guest~%") (read-text (merge-pathnames "g.txt" area)))
          "a guest write is on the host when the exec returns")
      (write-text (merge-pathnames "h.txt" area) "from-host")
      (ok (wait-until (lambda () (equal "from-host" (sh-out s "cat h.txt 2>/dev/null"))) 2)
          "a host write is in the guest within 2 s")
      (ok (eql 0 (sh s "sudo sh -c 'echo root > r.txt'")) "root may write the area too")
      (ok (equal (format nil "root~%") (read-text (merge-pathnames "r.txt" area)))))))

(deflive iso-guest-root-writes-stay-in-guest (backend)
  (with-tree (root area ro outside)
    (with-session (s backend (area-spec area))
      (ok (eql 0 (sh s "sudo sh -c 'echo owned > /etc/owned'")))
      (ok (equal "owned" (sh-out s "cat /etc/owned")))))
  (with-session (s backend nil)
    (ok (not (eql 0 (sh s "test -e /etc/owned"))) "the next session never sees it")))

;;; 5. vsock is the only inbound path

(deflive iso-vsock-only-inbound (backend)
  (with-session (s backend (sc:make-sandbox-spec :command '("true") :network :allow))
    (ok (null (unkernel-session-forwards s)) "nothing forwarded by default")
    (sh s "nohup sh -c 'while true; do echo pong | nc -l -p 7071; done' > /dev/null 2>&1 &")
    (sleep 1)
    (ok (not (tcp-connect-p 7071)) "a guest server is not on the host's port")
    (let ((port (forward-port s 7071)))
      (ok (and (integerp port) (plusp port)))
      (ok (equal (list port) (unkernel-session-forwards s)))
      (ok (search "pong" (tcp-exchange port (format nil "ping~%"))) "reachable through the forward")
      (ok (search "pong" (tcp-exchange port (format nil "ping~%"))) "each connection is a new bridge")
      (ok (eq t (close-forward s port)))
      (ok (null (close-forward s port)) "closed once")
      (ok (not (tcp-connect-p port)) "unreachable again")
      (ok (null (unkernel-session-forwards s))))))

(deflive iso-forward-loopback-only (backend)
  (with-session (s backend nil)
    (sh s "nohup sh -c 'while true; do echo pong | nc -l -p 7072; done' > /dev/null 2>&1 &")
    (let ((port (forward-port s 7072)))
      (let ((listing (nth-value 1 (pp:run (list "sh" "-c" (format nil "lsof -nP -iTCP:~d -sTCP:LISTEN 2>/dev/null || ss -ltnH 'sport = :~d'" port port))
                                              :output :string :error-output :string))))
        (ok (search (format nil "127.0.0.1:~d" port) listing) "the bridge listens on 127.0.0.1")
        (ok (not (or (search (format nil "*:~d" port) listing) (search (format nil "0.0.0.0:~d" port) listing)))
            "and on nothing else"))
      (close-forward s port))))

(deflive iso-host-command-port-closed (backend)
  (with-session (s backend nil)
    (ok (not (eql 0 (sh s (format nil "echo x | kwvsock connect ~d" +host-command-port+) :wall-clock 30)))
        "host functions are off: nothing answers on the command port")))
