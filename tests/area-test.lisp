(in-package #:compute-backend-unkernel/tests)

;;; The read-write area round trip and the private TMPDIR (live).

(deflive area-round-trip (backend)
  (with-tree (root area ro outside)
    (write-text (merge-pathnames "in.txt" area) (format nil "alpha~%beta~%"))
    (with-session (s backend (area-spec area))
      (ok (equal "f" (sh-out s "cat f")) "the host's file, at the same path")
      (ok (eql 0 (sh s "tr a-z A-Z < in.txt > out.txt")))
      (ok (equal (format nil "ALPHA~%BETA~%") (read-text (merge-pathnames "out.txt" area)))
          "the guest's write is on the host")
      (ok (eql 0 (sh s "mkdir -p d/e && echo deep > d/e/g && rm f")))
      (ok (equal (format nil "deep~%") (read-text (merge-pathnames "d/e/g" area))))
      (ok (not (uiop:file-exists-p (merge-pathnames "f" area))) "a delete reaches the host")
      (write-text (merge-pathnames "late.txt" area) "late")
      (ok (wait-until (lambda () (equal "late" (sh-out s "cat late.txt 2>/dev/null"))) 2)
          "a host write reaches the guest within 2 s")
      (ok (eql 0 (sh s "mv late.txt d/moved.txt")))
      (ok (equal "late" (read-text (merge-pathnames "d/moved.txt" area))) "a rename inside the area"))
    (ok (equal (format nil "ALPHA~%BETA~%") (read-text (merge-pathnames "out.txt" area)))
        "the files outlive the session")))

(deflive area-absolute-paths-agree (backend)
  (with-tree (root area ro outside)
    (with-session (s backend (area-spec area))
      (let ((path (concatenate 'string (ns area) "abs.txt")))
        (ok (eql 0 (sh s (format nil "echo here > '~a'" path))) "the host path works in the guest")
        (ok (equal (format nil "here~%") (read-text path)))))))

(deflive area-unusual-names (backend)
  (with-tree (root area ro outside)
    (with-session (s backend (area-spec area))
      (ok (eql 0 (sh s "echo x > 'with space.txt' && echo y > 'ünï.txt'")))
      (ok (equal (format nil "x~%") (read-text (merge-pathnames "with space.txt" area))))
      (ok (equal (format nil "y~%") (read-text (merge-pathnames "ünï.txt" area)))))))

(deflive area-private-tmpdir (backend)
  (with-tree (root area ro outside)
    (let (tmp)
      (with-session (s backend (area-spec area))
        (setf tmp (plan-tmp (unkernel-session-plan s)))
        (ok (stringp tmp))
        (ok (uiop:string-prefix-p (ns (uiop:ensure-directory-pathname (uiop:temporary-directory))) tmp)
            "under the physical system temp dir")
        (ok (search "stack-compute-" tmp))
        (ok (equal tmp (concatenate 'string (sh-out s "printf %s \"$TMPDIR\"") "/")) "TMPDIR")
        (ok (eql 0 (sh s "echo t > \"$TMPDIR/t.txt\"")))
        (ok (equal (format nil "t~%") (read-text (concatenate 'string tmp "t.txt")))
            "mounted read-write from the host"))
      (ok (not (uiop:directory-exists-p tmp)) "gone after close"))))

(deflive area-no-writable-starts-in-tmp (backend)
  (with-session (s backend nil)
    (let ((tmp (plan-tmp (unkernel-session-plan s))))
      (ok (equal (string-right-trim "/" tmp) (sh-out s "pwd"))))))
